# Snyk (https://snyk.io) policy file, patches or ignores known vulnerabilities.
version: v1.25.1
# ignores vulnerabilities until expiry date; change duration by modifying expiry date
ignore:
  'snyk:lic:maven:com.puppycrawl.tools:checkstyle:LGPL-2.1':
    - '*':
        reason: Build-time tool only
  'snyk:lic:maven:net.sf.saxon:Saxon-HE:MPL-2.0':
    - '*':
        reason: Build-time tool only (used by checkstyle)
  'snyk:lic:maven:org.mozilla:rhino:MPL-2.0':
    - '*':
        reason: Test-time tool only (used by MockServer)
  # Medium severity - zlib/zlib1g (Ubuntu 24.04 base-image OS package). Image is built and
  # scanned by the shared reusable workflow
  # ministryofjustice/laa-ccms-common-workflows/.github/workflows/ecr-publish-image.yml
  # (java_distribution: corretto, java_version: 25), NOT from this repo's own Dockerfile /
  # Dockerfile_internal (those only back local docker-compose dev images and are already
  # amazoncorretto:*-alpine + patched).
  SNYK-UBUNTU2404-ZLIB-19530295:
    - '*':
        reason: >-
          Base-image (Ubuntu 24.04) zlib/zlib1g Out-of-bounds Write, introduced via the
          shared ecr-publish-image reusable workflow's build image, not this repo's own
          Dockerfiles. No application-code or local-Dockerfile remediation available;
          will clear once that base image is rebuilt with an upstream fix.
        expires: 2026-11-25T00:00:00.000Z
  # Medium severity - glibc/libc6 (Ubuntu 24.04 base-image OS package), same shared
  # ecr-publish-image workflow build image as the zlib ignore above; not from this
  # repo's own Dockerfiles (amazoncorretto:*-alpine).
  SNYK-UBUNTU2404-GLIBC-19437583:
    - '*':
        reason: >-
          Base-image (Ubuntu 24.04) glibc/libc6 CVE-2026-18374, introduced via the
          shared ecr-publish-image reusable workflow's build image, not this repo's own
          Dockerfiles. No application-code or local-Dockerfile remediation available;
          will clear once that base image is rebuilt with an upstream fix.
        expires: 2026-11-25T00:00:00.000Z
  SNYK-UBUNTU2404-GLIBC-19785393:
    - '*':
        reason: >-
          Base-image (Ubuntu 24.04) glibc/libc6 CVE-2026-89092, introduced via the
          shared ecr-publish-image reusable workflow's build image, not this repo's own
          Dockerfiles (amazoncorretto:*-alpine). No application-code or local-Dockerfile
          remediation available; will clear once that base image is rebuilt with an
          upstream fix.
        expires: 2026-11-25T00:00:00.000Z
patch: {}
